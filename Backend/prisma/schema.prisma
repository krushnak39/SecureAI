generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountProvider {
  GITHUB
  GOOGLE
  PASSWORD
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum RepositoryProvider {
  GITHUB
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AnalysisTrigger {
  MANUAL
  PUSH
  PULL_REQUEST
  SCHEDULED
  API
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  RESOLVED
  IGNORED
  SUPPRESSED
}

enum FindingCategory {
  CODE_QUALITY
  SECURITY
  PERFORMANCE
  ARCHITECTURE
  MAINTAINABILITY
  DEPENDENCY
}

enum DependencyEcosystem {
  NPM
  PYPI
  MAVEN
  OTHER
}

enum DependencyType {
  DIRECT
  TRANSITIVE
}

enum DependencyStatus {
  HEALTHY
  OUTDATED
  VULNERABLE
  DEPRECATED
}

enum DocumentType {
  README
  API
  ARCHITECTURE
  SETUP
  DATABASE
  CONTRIBUTION
  CUSTOM
}

enum DocumentStatus {
  COMPLETE
  PARTIAL
  MISSING
  GENERATING
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum CodeChunkLanguage {
  TYPESCRIPT
  JAVASCRIPT
  PYTHON
  JAVA
  CSHARP
  GO
  RUST
  SQL
  HTML
  CSS
  JSON
  YAML
  MARKDOWN
  OTHER
}

enum CIWorkflowStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum PullRequestStatus {
  OPEN
  CLOSED
  MERGED
}

enum CheckStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String?
  avatarUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  projects     Project[]
  chatSessions ChatSession[]

  @@index([email])
}

model Account {
  id                String          @id @default(cuid())
  userId            String
  provider          AccountProvider
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String        @id @default(cuid())
  ownerId     String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  repositories Repository[]

  @@index([ownerId])
  @@index([status])
}

model Repository {
  id        String             @id @default(cuid())
  projectId String
  provider  RepositoryProvider @default(GITHUB)

  externalId    String?
  name          String
  fullName      String
  url           String
  defaultBranch String  @default("main")
  branch        String?

  language  String?
  isPrivate Boolean @default(false)

  connectedAt  DateTime  @default(now())
  lastAnalyzed DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analyses     Analysis[]
  dependencies Dependency[]
  codeChunks   CodeChunk[]
  documents    Document[]
  workflows    CIWorkflow[]
  pullRequests PullRequest[]
  chatSessions ChatSession[]

  @@index([projectId])
  @@index([fullName])
  @@index([provider, externalId])
}

model Analysis {
  id           String          @id @default(cuid())
  repositoryId String
  status       AnalysisStatus  @default(QUEUED)
  trigger      AnalysisTrigger @default(MANUAL)

  branch    String?
  commitSha String?

  startedAt   DateTime?
  completedAt DateTime?

  healthScore     Int?
  codeQuality     Int?
  securityScore   Int?
  performance     Int?
  architecture    Int?
  maintainability Int?

  filesAnalyzed Int @default(0)
  linesAnalyzed Int @default(0)

  errorMessage String?

  createdAt DateTime @default(now())

  repository             Repository              @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings               Finding[]
  performanceIssues      PerformanceIssue[]
  architectureComponents ArchitectureComponent[]

  @@index([repositoryId])
  @@index([status])
  @@index([createdAt])
}

model Finding {
  id         String @id @default(cuid())
  analysisId String

  severity FindingSeverity
  status   FindingStatus   @default(OPEN)
  category FindingCategory

  title          String
  description    String
  impact         String?
  recommendation String?

  filePath     String?
  lineStart    Int?
  lineEnd      Int?
  functionName String?

  rule       String?
  scanner    String?
  evidence   String?
  confidence Int?

  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([severity])
  @@index([status])
  @@index([category])
}

model Dependency {
  id           String @id @default(cuid())
  repositoryId String

  name           String
  ecosystem      DependencyEcosystem
  type           DependencyType
  currentVersion String
  latestVersion  String?

  status   DependencyStatus @default(HEALTHY)
  severity FindingSeverity?

  advisoryId String?
  advisory   String?

  description    String?
  impact         String?
  recommendation String?

  files      Json?
  dependents Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([status])
  @@index([ecosystem])
}

model PerformanceIssue {
  id         String @id @default(cuid())
  analysisId String

  severity FindingSeverity
  category String

  title          String
  description    String
  impact         String?
  recommendation String?

  filePath String?
  line     Int?

  metric        String?
  currentValue  Float?
  expectedValue Float?

  evidence String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([severity])
}

model ArchitectureComponent {
  id         String @id @default(cuid())
  analysisId String

  name        String
  type        String
  technology  String?
  description String?

  files  Json?
  health Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  outgoingRelationships ArchitectureRelationship[] @relation("ArchitectureSource")
  incomingRelationships ArchitectureRelationship[] @relation("ArchitectureTarget")

  @@index([analysisId])
}

model ArchitectureRelationship {
  id String @id @default(cuid())

  sourceId String
  targetId String
  relation String

  metadata Json?

  createdAt DateTime @default(now())

  source ArchitectureComponent @relation("ArchitectureSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target ArchitectureComponent @relation("ArchitectureTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relation])
  @@index([sourceId])
  @@index([targetId])
}

model CodeChunk {
  id           String @id @default(cuid())
  repositoryId String

  filePath   String
  symbolName String?
  startLine  Int?
  endLine    Int?

  language   CodeChunkLanguage
  content    String
  tokenCount Int?

  hash String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([filePath])
  @@index([language])
}

model Document {
  id           String @id @default(cuid())
  repositoryId String

  type   DocumentType
  status DocumentStatus @default(MISSING)

  title   String
  content String?

  completeness Int?

  sourceFiles Json?
  metadata    Json?

  generatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, type])
  @@index([repositoryId])
  @@index([status])
}

model ChatSession {
  id           String  @id @default(cuid())
  userId       String
  repositoryId String?

  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository?   @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]

  @@index([userId])
  @@index([repositoryId])
}

model ChatMessage {
  id        String @id @default(cuid())
  sessionId String

  role    ChatRole
  content String

  citations  Json?
  tokenCount Int?

  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model CIWorkflow {
  id           String @id @default(cuid())
  repositoryId String

  name         String
  workflowFile String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repository Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  runs       CIWorkflowRun[]

  @@unique([repositoryId, workflowFile])
  @@index([repositoryId])
}

model CIWorkflowRun {
  id         String @id @default(cuid())
  workflowId String

  externalId String?
  branch     String?
  commitSha  String?

  status CIWorkflowStatus @default(QUEUED)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  workflow CIWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  checks   CICheck[]

  @@index([workflowId])
  @@index([status])
}

model CICheck {
  id    String @id @default(cuid())
  runId String

  name   String
  status CheckStatus @default(QUEUED)

  conclusion String?
  logsUrl    String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  run CIWorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
}

model PullRequest {
  id           String @id @default(cuid())
  repositoryId String

  externalId Int?
  number     Int?

  title        String
  author       String?
  sourceBranch String?
  targetBranch String?

  status PullRequestStatus @default(OPEN)

  url String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  mergedAt  DateTime?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([status])
}

